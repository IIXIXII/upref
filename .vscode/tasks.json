{
    "version": "2.0.0",
    "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "close": false
    },
    "tasks": [
        {
            "label": "Setup",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "setup"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Test",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "pytest",
                "-p",
                "no:cacheprovider",
                "tests"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Ruff check",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "ruff",
                "check",
                "upref",
                "tests",
                "examples",
                "scripts",
                "docs/conf.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Ruff format check",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "ruff",
                "format",
                "--check",
                "upref",
                "tests",
                "examples",
                "scripts",
                "docs/conf.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Mypy",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "mypy",
                "upref",
                "examples"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Check",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "check"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Verify",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Check",
                "Test"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docs (Sphinx)",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "docs"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "${workspaceFolder}/make.bat",
            "args": [
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run current file",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
